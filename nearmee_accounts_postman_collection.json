            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"username\": \"customer_jane\",\n    \"email\": \"jane.doe@gmail.com\",\n    \"password\": \"password123\",\n    \"confirm_password\": \"password123\",\n    \"user_type\": \"CUSTOMER\",\n    \"first_name\": \"Jane\",\n    \"last_name\": \"Doe\",\n    \"phone_number\": \"+1234567890\",\n    \"location\": \"San Francisco, CA\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/api/accounts/register/",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "accounts",
                        "register",
                        ""
                    ]
                }
            },
            "response": []
